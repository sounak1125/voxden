{
  "name": "voxden",
  "productName": "Voxden",
  "version": "1.0.1",
  "description": "Private, system-wide dictation for Windows",
  "main": "src/main.js",
  "author": "Sounak",
  "repository": {
    "type": "git",
    "url": "https://github.com/sounak1125/voxden.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-cleanup.js && node scripts/test-verbatim.js && node scripts/test-dictionary.js && node scripts/test-phonetics.js && node scripts/test-corpus.js && node scripts/test-models.js && node scripts/test-asr.js && node scripts/test-vocabulary.js && node scripts/test-style.js && node scripts/test-rewriter.js && node scripts/test-language-packs.js && node scripts/test-zip.js && node scripts/test-asr-runtime.js && node scripts/test-asr-model.js && node scripts/test-local-rewrite-runtime.js && node scripts/test-metrics.js && node scripts/test-insights.js && node scripts/test-suggestions.js && node scripts/test-win32.js && node scripts/test-tray.js && node scripts/test-hotkeys.js && node scripts/test-chunking.js && node scripts/test-sidecar.js",
    "prepare:language-packs": "node scripts/prepare-language-pack-release.js",
    "prepare:asr-runtime": "node scripts/prepare-asr-runtime.js",
    "prepare:asr-model": "node scripts/prepare-asr-model.js",
    "prepare:installer-art": "node scripts/generate-installer-art.js",
    "dist": "node scripts/generate-installer-art.js && electron-builder --win nsis --publish never",
    "release": "node scripts/generate-installer-art.js && electron-builder --win nsis --publish always"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "productName": "Voxden",
    "copyright": "Copyright © 2026 Sounak",
    "appId": "com.voxden.app",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/icon-reference.png",
      "!assets/icon-source.*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "!__pycache__",
          "!**/*.pyc"
        ]
      },
      {
        "from": "scripts/win32.ps1",
        "to": "scripts/win32.ps1"
      },
      {
        "from": "scripts/vocabulary-seed.json",
        "to": "scripts/vocabulary-seed.json"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "sounak1125",
      "repo": "voxden"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Voxden",
      "artifactName": "Voxden-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
