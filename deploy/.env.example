# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The hostname the app talks to. Caddy fetches a certificate for it; the DNS
# A record must point at this machine before `docker compose up`.
ACCOUNT_DOMAIN=account.voxden.app

# Which image tag to run. `latest` follows main; a git SHA pins a build.
ACCOUNT_IMAGE_TAG=latest

# --- sign-in emails ---------------------------------------------------------
# Without a key, sign-in codes print to the container log instead of sending.
RESEND_API_KEY=
MAIL_FROM=Voxden <sign-in@voxden.app>

# --- Google sign-in ----------------------------------------------------------
# An OAuth client of type "Desktop app" from console.cloud.google.com. Leave
# empty to offer only the emailed code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- feedback tickets in Discord -------------------------------------------
# Webhooks of two forum channels: one for bugs, one for ideas and other
# feedback. Leave empty to keep reports only in the database.
DISCORD_BUGS_WEBHOOK=
DISCORD_IDEAS_WEBHOOK=
# Voxden Desk, the bot that tags tickets Open/Done and answers /done, /reopen, /open.
DISCORD_BOT_TOKEN=

# --- cloud transcription ----------------------------------------------------
# Without a key, /v1/transcribe answers 503 and the app dictates locally.
OPENROUTER_API_KEY=
# Leave empty to use the default recognizer set in server/cloud.js.
CLOUD_MODEL=
CLOUD_HOURS_CAP=10
# Optional. 1 credit = 1 minute. Default is CLOUD_HOURS_CAP × 60.
# CLOUD_CREDITS_CAP=600
# month (default) or never. never is for a developer key with no monthly reset.
# CLOUD_CREDITS_RESET=month

# --- free plan --------------------------------------------------------------
# Words a free account may dictate on its own PC in any seven-day period.
# Free dictation never reaches this service; the app enforces the number and
# reads it from here, so changing it needs no new installer.
FREE_WEEKLY_WORDS=3000

# --- payments: India (keys + monthly plan, or leave empty) -----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan must charge INR 34900 paise, monthly, interval 1.
RAZORPAY_PLAN_MONTHLY=
# Optional legacy ID; annual purchases are disabled.
RAZORPAY_PLAN_ANNUAL=

# --- payments: everywhere else (keys + monthly variant, or leave empty) ----
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_MONTHLY=
# Optional legacy ID; annual purchases are disabled.
LEMONSQUEEZY_VARIANT_ANNUAL=

# --- global monthly label (India is fixed at ₹349/month) -------------------
PRICE_GLOBAL_MONTHLY=
