# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The hostname the app talks to. Caddy fetches a certificate for it; the DNS
# A record must point at this machine before `docker compose up`.
ACCOUNT_DOMAIN=account.voxden.app

# Which image tag to run. `latest` follows main; a git SHA pins a build.
ACCOUNT_IMAGE_TAG=latest

# --- sign-in emails ---------------------------------------------------------
# Without a key, email sign-in is unavailable. Verify the sender domain first.
RESEND_API_KEY=
MAIL_FROM=Voxden <sign-in@voxden.app>

# --- Google sign-in ----------------------------------------------------------
# An OAuth client of type "Desktop app" from console.cloud.google.com. Leave
# empty to offer only the emailed code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- feedback tickets in Discord -------------------------------------------
# Webhooks of two forum channels: one for bugs, one for ideas and other
# feedback. Leave empty to keep reports only in the database.
DISCORD_BUGS_WEBHOOK=
DISCORD_IDEAS_WEBHOOK=
# Voxden Desk, the bot that tags tickets Open/Done and answers /done, /reopen,
# /open and /stats.
DISCORD_BOT_TOKEN=
# A private text channel the bot can see and post in. The Monday digest goes
# here. Turn on Developer Mode in Discord, right-click the channel, Copy
# Channel ID. Leave empty to keep /stats without a scheduled post.
DISCORD_STATS_CHANNEL=

# --- cloud transcription ----------------------------------------------------
# Without a key, /v1/transcribe answers 503 and the app dictates locally.
OPENROUTER_API_KEY=
# The main speech model. Empty means the code default in server/cloud.js
# (microsoft/mai-transcribe-2), so a new .env that leaves this blank changes
# the model; production sets assemblyai/universal-3-5-pro. The model's family
# decides which dictation languages are accepted and how privacy is asked for
# (zero data retention for assemblyai/ and microsoft/, data collection denied
# for any other).
CLOUD_MODEL=
# The rescue: ONE request to a second model beside the main one when it goes
# quiet or fails. These three are commented out on purpose. Unset means the
# default (assemblyai/universal-3-5-pro, or openai/gpt-4o-mini-transcribe when
# the main model is AssemblyAI); an EMPTY CLOUD_RESCUE_MODEL= or "none" turns
# the rescue off. Production: openai/gpt-4o-mini-transcribe.
# CLOUD_RESCUE_MODEL=openai/gpt-4o-mini-transcribe
# Milliseconds the main model may go quiet before the rescue is sent (default
# 4000, plus 100 per second of audio, 8000 at most; 0 turns the rescue off).
# CLOUD_RESCUE_MS=4000
# A second identical request to the SAME model after this many ms of quiet.
# Off while a rescue is on, unless set here (then both run). Leave it out.
# CLOUD_HEDGE_MS=
# Whether the silent warm-up clip goes upstream: auto (default) skips it when
# the main model is AssemblyAI, on always sends it, off never does.
# CLOUD_WARMUP=auto
# Dictation lanes (apps from 2.1.11): pieces cut while the user talks go to
# CLOUD_BODY_MODEL, the last piece goes to CLOUD_MODEL, and pieces still out
# when the user stops are handed to the body model's rescue at once. Unset or
# empty CLOUD_BODY_MODEL keeps everything on CLOUD_MODEL, exactly as before.
# CLOUD_BODY_MODEL=microsoft/mai-transcribe-2
# Who the lanes are on for: comma-separated emails, or * for everyone. Empty
# is nobody. Clearing it (or CLOUD_BODY_MODEL) and restarting is the rollback.
# CLOUD_BODY_USERS=
# The body model's rescue (default assemblyai/universal-3-5-pro) and how long
# a body piece may go quiet before it is sent (default 8000). "none" or 0
# leaves the lanes off: without a rescue every stop would wait on the body model.
# CLOUD_BODY_RESCUE_MODEL=assemblyai/universal-3-5-pro
# CLOUD_BODY_RESCUE_MS=8000
# auto (default), on or off, as CLOUD_WARMUP, for the body model.
# CLOUD_BODY_WARMUP=auto
# The piece sizes those accounts are told to cut at, in ms: a piece ends at a
# SILENCE pause once it is MIN long, or a LONG_SILENCE pause once it is LONG.
# CLOUD_SEGMENT_MIN_MS=4000
# CLOUD_SEGMENT_SILENCE_MS=700
# CLOUD_SEGMENT_LONG_MS=45000
# CLOUD_SEGMENT_LONG_SILENCE_MS=300
# Body pieces one account may have out at once (default 4).
# CLOUD_BODY_CALLS=4
# Milliseconds after the app stops before a body piece still out is rescued
# (default 0, at once).
# CLOUD_URGENT_DELAY_MS=0
CLOUD_HOURS_CAP=15
# Optional. 1 credit = 1 minute. Default is CLOUD_HOURS_CAP × 60.
# CLOUD_CREDITS_CAP=900
# A subscriber's first credit month, once per account. 0 turns the offer off.
CLOUD_WELCOME_CREDITS=1200
# A free account's one-time Voxden Cloud trial, in minutes (the Android app's
# free trial). 0 turns it off.
CLOUD_TRIAL_CREDITS=60
# month (default) or never. never is for a developer key with no monthly reset.
# CLOUD_CREDITS_RESET=month

# --- regional prices --------------------------------------------------------
# Each account is placed in India (₹349) or global ($8) pricing from the
# address of its first sign-in, using DB-IP's free country table, which the
# service downloads to /data each month by itself. Leave these empty.
# GEOIP=off turns regions off; GEOIP_UPDATE=off stops the monthly download.
GEOIP=
GEOIP_UPDATE=

# --- free plan --------------------------------------------------------------
# Words a free account may dictate on its own PC in any seven-day period.
# Free dictation never reaches this service; the app enforces the number and
# reads it from here, so changing it needs no new installer.
FREE_WEEKLY_WORDS=3000

# --- payments: Razorpay (keys + monthly plans, or leave empty) -------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# India. Plan must charge INR 34900 paise, monthly, interval 1.
RAZORPAY_PLAN_MONTHLY=
# Everywhere else. Plan must charge USD 800 cents, monthly, interval 1, and
# needs international cards enabled on the account. Empty: India only.
RAZORPAY_PLAN_MONTHLY_GLOBAL=
# Optional legacy ID; annual purchases are disabled.
RAZORPAY_PLAN_ANNUAL=
# Countries the $8 offer is not sold in, as comma-separated ISO codes. Leave
# the line out for the default (the EU, the UK, Monaco, the Isle of Man);
# an empty value sells everywhere.
# CLOSED_COUNTRIES=
