# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The hostname the app talks to. Caddy fetches a certificate for it; the DNS
# A record must point at this machine before `docker compose up`.
ACCOUNT_DOMAIN=account.voxden.app

# Which image tag to run. `latest` follows main; a git SHA pins a build.
ACCOUNT_IMAGE_TAG=latest

# --- sign-in emails ---------------------------------------------------------
# Without a key, email sign-in is unavailable. Verify the sender domain first.
RESEND_API_KEY=
MAIL_FROM=Voxden <sign-in@voxden.app>

# --- Google sign-in ----------------------------------------------------------
# An OAuth client of type "Desktop app" from console.cloud.google.com. Leave
# empty to offer only the emailed code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- feedback tickets in Discord -------------------------------------------
# Webhooks of two forum channels: one for bugs, one for ideas and other
# feedback. Leave empty to keep reports only in the database.
DISCORD_BUGS_WEBHOOK=
DISCORD_IDEAS_WEBHOOK=
# Voxden Desk, the bot that tags tickets Open/Done and answers /done, /reopen,
# /open and /stats.
DISCORD_BOT_TOKEN=
# A private text channel the bot can see and post in. The Monday digest goes
# here. Turn on Developer Mode in Discord, right-click the channel, Copy
# Channel ID. Leave empty to keep /stats without a scheduled post.
DISCORD_STATS_CHANNEL=

# --- cloud transcription ----------------------------------------------------
# Without a key, /v1/transcribe answers 503 and the app dictates locally.
OPENROUTER_API_KEY=
# Leave empty to use the default recognizer set in server/cloud.js.
CLOUD_MODEL=
CLOUD_HOURS_CAP=15
# Optional. 1 credit = 1 minute. Default is CLOUD_HOURS_CAP × 60.
# CLOUD_CREDITS_CAP=900
# A subscriber's first credit month, once per account. 0 turns the offer off.
CLOUD_WELCOME_CREDITS=1200
# month (default) or never. never is for a developer key with no monthly reset.
# CLOUD_CREDITS_RESET=month

# --- regional prices --------------------------------------------------------
# Each account is placed in India (₹349) or global ($8) pricing from the
# address of its first sign-in, using DB-IP's free country table, which the
# service downloads to /data each month by itself. Leave these empty.
# GEOIP=off turns regions off; GEOIP_UPDATE=off stops the monthly download.
GEOIP=
GEOIP_UPDATE=

# --- free plan --------------------------------------------------------------
# Words a free account may dictate on its own PC in any seven-day period.
# Free dictation never reaches this service; the app enforces the number and
# reads it from here, so changing it needs no new installer.
FREE_WEEKLY_WORDS=3000

# --- payments: Razorpay (keys + monthly plans, or leave empty) -------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# India. Plan must charge INR 34900 paise, monthly, interval 1.
RAZORPAY_PLAN_MONTHLY=
# Everywhere else. Plan must charge USD 800 cents, monthly, interval 1, and
# needs international cards enabled on the account. Empty: India only.
RAZORPAY_PLAN_MONTHLY_GLOBAL=
# Optional legacy ID; annual purchases are disabled.
RAZORPAY_PLAN_ANNUAL=
# Countries the $8 offer is not sold in, as comma-separated ISO codes. Leave
# the line out for the default (the EU, the UK, Monaco, the Isle of Man);
# an empty value sells everywhere.
# CLOSED_COUNTRIES=
